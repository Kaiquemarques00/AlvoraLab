      "css": ".ds-button-secondary{display:inline-flex;align-items:center;justify-content:center;gap:18px;min-height:54px;padding:13px 21px;border:1px solid #adb1bd;border-radius:7px;background:transparent;color:var(--ink-strong,#202438);font:700 16px Rambla,Arial,sans-serif;cursor:pointer;transition:border-color .2s,color .2s,transform .2s}.ds-button-secondary svg{width:21px;height:21px;transition:transform .25s cubic-bezier(.2,.8,.2,1)}.ds-button-secondary:hover{border-color:var(--brand,#163bff);color:var(--brand,#163bff);transform:translateY(-1px)}.ds-button-secondary:hover svg{transform:translateX(4px)}.ds-button-secondary:focus-visible{outline:3px solid var(--brand-soft,#8697ff);outline-offset:4px}"
